#!/bin/sh
# PGPony Flatpak launcher (/app/bin/pgpony). Preloads the runtime's FreeType so the JVM and GTK
# share one copy: Skiko's FreeType otherwise sits ahead of the system one, the GTK file chooser
# fails with "error occurred in libfreetype" and opens blank (issue #1). Mirrors the AppImage
# AppRun and tools/linux-wrap-launcher.sh; the runtime keeps its libraries in the multiarch
# directory under /usr/lib.
SYS_FT=""
for d in /usr/lib/*/ /usr/lib/; do
  if [ -e "${d}libfreetype.so.6" ]; then SYS_FT="${d}libfreetype.so.6"; break; fi
done
if [ -n "$SYS_FT" ]; then
  LD_PRELOAD="${SYS_FT}${LD_PRELOAD:+:$LD_PRELOAD}"
  export LD_PRELOAD
fi
exec /app/pgpony/bin/PGPony "$@"
